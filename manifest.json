{
  "manifest_version": 3,
  "name": "AI Text Summarizer",
  "version": "1.3",
  "description": "Fasst markierten Text oder ganze Artikel mit OpenAI's GPT-Technologie zusammen. Automatische Artikelerkennung, anpassbare Tonalitäten und Markdown-Export.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "Popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "summarize-article": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Artikel auf der aktuellen Seite zusammenfassen"
    }
  }
}